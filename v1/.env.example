# ------------------------------------------------------------------ #
# GitLab Migration — environment template
#
# Copy to .env and replace every <token> placeholder with a real
# Personal Access Token (api scope). .env is gitignored; this template
# is the only version that belongs in version control.
#
#   cp .env.example .env
#   python gitlab_migration.py --env-source .env --sanity-check
#
# The script rejects any value still left as a <...> placeholder.
# ------------------------------------------------------------------ #

# ---- GitLab instance base URLs ---- #
SOURCE_GITLAB_URL=https://rcode.rockefeller.edu
DEST_GITLAB_URL=https://gitlab.com

# ---- Admin PATs ---- #
# SOURCE_GITLAB_TOKEN reads everything from the source project.
# DEST_GITLAB_TOKEN must hold Owner on the destination project: it
# creates labels, milestones, boards, the IID counter bump, and any
# issue or note whose source author is not in mappings.yml.
SOURCE_GITLAB_TOKEN=<token>
DEST_GITLAB_TOKEN=<token>

# ---- Per-user PATs (full-fidelity authorship) ---- #
# One PAT per user in mappings.yml, named by that user's pat_env key.
# Each of these users must hold Owner on the destination project for
# the migration window so their token may set iid and created_at.
# All five are REQUIRED: --sanity-check fails if any of them is missing
# or still left as <token>. To migrate without a user's PAT, remove that
# user from mappings.yml instead — their content then falls back to
# DEST_GITLAB_TOKEN with a markdown attribution header
# (fidelity=admin_attributed).
PAT_JHERRERA15=<token>
PAT_JBANFELDER=<token>
PAT_DEST2=<token>
PAT_DEST4=<token>
PAT_DEST5=<token>

# ---- Concurrency and timeouts ---- #
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=60

# ---- Retry / exponential backoff ---- #
RETRY_COUNT=5
RETRY_BACKOFF=2
